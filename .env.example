# 自动评分无需 AI API 密钥。
# 小红书专用数据源可选；不配置时会使用公开兜底源。
JUSTONE_API_TOKEN=your-optional-token

# 小红书问点点提问接口；GitHub Actions 中配置为同名 secrets。
DIANDIAN_API_URL=https://your-diandian-gateway.example/query
DIANDIAN_API_TOKEN=your-optional-token
# 本地调试可设为 morning 或 afternoon；定时任务默认按北京时间自动判断。
# DIANDIAN_PERIOD=morning